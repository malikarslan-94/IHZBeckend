DATABASE_URL="postgresql://USER:PASSWORD@NEON_HOST/IHZ?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
PORT=3001
# Set to "*" to accept requests from any HTTP(S) frontend origin.
CLIENT_URL="http://localhost:5174"
NODE_ENV=development
TZ=Asia/Karachi

# Required only when initializing accounts with npm run db:seed (12+ characters).
SEED_ADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""
# Optional: Puppeteer uses its downloaded browser unless a path is supplied.
PUPPETEER_EXECUTABLE_PATH=""
PUPPETEER_NO_SANDBOX=false
