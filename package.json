  "test:api": "vitest run tests/api.test.ts tests/priority-fixes.test.ts"
 },
 "dependencies": {
  "@prisma/client": "6.19.0",
  "bcrypt": "^6.0.0",
  "cookie-parser": "^1.4.7",
  "cors": "^2.8.5",
  "decimal.js": "^10.6.0",
  "dotenv": "^17.2.3",
  "exceljs": "^4.4.0",
  "express": "^5.1.0",
  "express-rate-limit": "^8.2.1",
  "handlebars": "^4.7.8",
  "helmet": "^8.1.0",
  "jsonwebtoken": "^9.0.2",
  "multer": "^2.0.2",
  "puppeteer": "^24.31.0",
  "zod": "^3.25.76"
 },
 "devDependencies": {
  "@types/bcrypt": "^6.0.0",
  "@types/cookie-parser": "^1.4.9",
  "@types/cors": "^2.8.19",
  "@types/express": "^5.0.5",
  "@types/jsonwebtoken": "^9.0.10",
  "@types/multer": "^2.0.0",
  "@types/node": "^22.19.0",
  "@types/supertest": "^6.0.3",
  "prisma": "6.19.0",
  "supertest": "^7.1.4",
  "tsx": "^4.20.6",
  "typescript": "5.9.3",
  "vitest": "^3.2.4"
 }
