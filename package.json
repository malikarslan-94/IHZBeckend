{
 "name": "@home-nursing/server",
 "version": "1.0.0",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "tsx src/index.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/src/index.js",
  "db:generate": "prisma generate",
  "db:deploy": "prisma migrate deploy",
  "db:seed": "tsx prisma/seed.ts",
